// tiri's config, in KDL (https://kdl.dev), like niri's.
//
// tiri reads it from $XDG_CONFIG_HOME/tiri/config.kdl, or
// ~/.config/tiri/config.kdl, each time a terminal attaches, so changes
// apply from the next attach. Everything set here is what tiri does
// without a config; print this again with `tiri config default`.
//
// A node starting with /- is commented out: remove the /- to use it.

// The theme for tiri's own borders, status bar and hints. Pane contents
// keep their programs' and your terminal's colors whatever the theme.
//
// Built in are "default", which uses your terminal's palette, and "oxide".
// Or name a theme defined below.
theme "default"

// A theme of your own. Colors are "#rrggbb", or 0 to 255 for a color from
// your terminal's palette. Anything left out comes from the theme named in
// `based-on`, or from "default" if there's none. Define as many as you
// like; themes may build on ones defined above them.
//
// These are the default theme's colors.
/-define-theme "mine" based-on="default" {
    // The focused pane's border, and its marker in the status bar.
    focused-border 12
    unfocused-border 8
    status-fg 250
    status-bg 236
    // The active workspace's number in the status bar.
    status-active-fg 236
    status-active-bg 250
    // Hints, empty workspaces, and columns scrolled out of view.
    dim 242
    // Behind selected text; "reverse" swaps the text's own colors instead.
    selection-bg "reverse"
}

// Sizes, as niri gives them. switch-preset-column-width (Ctrl+a r) steps
// the focused column through preset-column-widths, and new columns open at
// default-column-width. In a stack, switch-preset-pane-height (Ctrl+a R)
// steps the focused pane through preset-pane-heights; the panes without one
// share what's left, and reset-pane-height puts a pane back to sharing.
//
// A proportion is a share of the screen's width or height, above 0 and at
// most 1. fixed is a number of characters across or lines down, borders
// included, as in `fixed 80`.
layout {
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }
    preset-pane-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}

// Key bindings. Keys are written like niri's: a key, after any of Ctrl+,
// Alt+ and Shift+, as in Alt+Enter or Shift+h. Shift+h, Shift+H and H are
// the same key. Characters KDL keeps for itself, like [ , and {, go in
// quotes: "[" or "Alt+,".
//
// Your config's bindings add to these: a key you bind replaces the one
// here, and `key { unbind; }` removes it. A key can run several actions,
// one after another, as in two shells stacked in one column:
//
//   Alt+t { new-column; new-column; consume-or-expel-pane-left; }
//
// Every action:
//
//   new-column                       a new column with a shell, right of this one
//   focus-column-left/right          focus-column-first/last
//   move-column-left/right
//   focus-pane-up/down               within the column
//   move-pane-up/down
//   consume-or-expel-pane-left/right into the column to that side, or out of it
//   consume-pane-into-column         pull the next column's pane into this one
//   expel-pane-from-column           push the focused pane out to its own column
//   switch-preset-column-width       cycle through the widths
//   switch-preset-pane-height        cycle a pane in a stack through the heights
//   reset-pane-height                back to sharing the column's height
//   maximize-column                  full width, or back
//   fullscreen-pane                  the whole column's height, or back
//   center-column
//   close-pane
//   focus-workspace-down/up
//   move-column-to-workspace-down/up
//   toggle-overview                  close-overview
//   toggle-thumbnails                images or text in the overview, where the terminal can show images
//   detach                           leave everything running, and come back with `tiri`
//   kill-server                      end every pane

// The prefix, tmux-style: press it, then a key from prefix-binds. Press it
// twice to send it to the pane. After the prefix, a key that isn't bound
// itself also works with Ctrl held, so Ctrl+a Ctrl+n is Ctrl+a n.
prefix "Ctrl+a"

prefix-binds {
    n { new-column; }
    Enter { new-column; }

    h { focus-column-left; }
    Left { focus-column-left; }
    l { focus-column-right; }
    Right { focus-column-right; }
    j { focus-pane-down; }
    Down { focus-pane-down; }
    k { focus-pane-up; }
    Up { focus-pane-up; }
    "0" { focus-column-first; }
    Home { focus-column-first; }
    $ { focus-column-last; }
    End { focus-column-last; }

    Shift+h { move-column-left; }
    Shift+l { move-column-right; }
    Shift+j { move-pane-down; }
    Shift+k { move-pane-up; }

    "[" { consume-or-expel-pane-left; }
    "]" { consume-or-expel-pane-right; }
    "," { consume-pane-into-column; }
    "." { expel-pane-from-column; }

    u { focus-workspace-down; }
    PageDown { focus-workspace-down; }
    i { focus-workspace-up; }
    PageUp { focus-workspace-up; }
    Shift+u { move-column-to-workspace-down; }
    Shift+i { move-column-to-workspace-up; }

    r { switch-preset-column-width; }
    Shift+r { switch-preset-pane-height; }
    f { maximize-column; }
    Shift+f { fullscreen-pane; }
    c { center-column; }

    o { toggle-overview; }
    x { close-pane; }
    d { detach; }
    q { kill-server; }
}

// Keys that act straight away, without the prefix, like niri's Mod keys.
// They work in the overview too. On macOS, Alt needs your terminal's
// "Option as Meta" setting.
binds {
    Alt+Enter { new-column; }

    Alt+h { focus-column-left; }
    Alt+Left { focus-column-left; }
    Alt+l { focus-column-right; }
    Alt+Right { focus-column-right; }
    Alt+j { focus-pane-down; }
    Alt+Down { focus-pane-down; }
    Alt+k { focus-pane-up; }
    Alt+Up { focus-pane-up; }

    Alt+Shift+h { move-column-left; }
    Alt+Shift+l { move-column-right; }
    Alt+Shift+j { move-pane-down; }
    Alt+Shift+k { move-pane-up; }

    // Alt+[ starts an escape sequence, so these are on { and } instead.
    "Alt+{" { consume-or-expel-pane-left; }
    "Alt+}" { consume-or-expel-pane-right; }
    "Alt+," { consume-pane-into-column; }
    "Alt+." { expel-pane-from-column; }

    Alt+u { focus-workspace-down; }
    Alt+PageDown { focus-workspace-down; }
    Alt+i { focus-workspace-up; }
    Alt+PageUp { focus-workspace-up; }
    Alt+Shift+u { move-column-to-workspace-down; }
    Alt+Shift+i { move-column-to-workspace-up; }

    Alt+r { switch-preset-column-width; }
    Alt+Shift+r { switch-preset-pane-height; }
    Alt+f { maximize-column; }
    Alt+Shift+f { fullscreen-pane; }
    Alt+c { center-column; }

    Alt+o { toggle-overview; }
}

// Keys while the overview is open, which takes the keyboard: nothing typed
// reaches the panes. Keys not bound here fall through to binds.
overview-binds {
    Enter { close-overview; }
    o { close-overview; }
    Escape { close-overview; }

    n { new-column; }

    h { focus-column-left; }
    Left { focus-column-left; }
    l { focus-column-right; }
    Right { focus-column-right; }
    j { focus-pane-down; }
    Down { focus-pane-down; }
    k { focus-pane-up; }
    Up { focus-pane-up; }
    "0" { focus-column-first; }
    Home { focus-column-first; }
    $ { focus-column-last; }
    End { focus-column-last; }

    Shift+h { move-column-left; }
    Shift+l { move-column-right; }
    Shift+j { move-pane-down; }
    Shift+k { move-pane-up; }

    "[" { consume-or-expel-pane-left; }
    "]" { consume-or-expel-pane-right; }
    "," { consume-pane-into-column; }
    "." { expel-pane-from-column; }

    u { focus-workspace-down; }
    PageDown { focus-workspace-down; }
    i { focus-workspace-up; }
    PageUp { focus-workspace-up; }
    Shift+u { move-column-to-workspace-down; }
    Shift+i { move-column-to-workspace-up; }

    r { switch-preset-column-width; }
    Shift+r { switch-preset-pane-height; }
    f { maximize-column; }
    Shift+f { fullscreen-pane; }

    x { close-pane; }
    t { toggle-thumbnails; }
}
